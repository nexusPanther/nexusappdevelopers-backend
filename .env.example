# ==========================================
# MongoDB Database Configuration
# ==========================================
MONGO_USER=your_mongo_username
MONGO_PASSWORD=your_mongo_password
MONGO_CLUSTER=cluster0.example.mongodb.net
MONGO_DBNAME=nexusApp

# ==========================================
# Server Configuration
# ==========================================
PORT=3005
BASE_URL=http://localhost:3005/api

# ==========================================
# Security & JWT
# ==========================================
JWT_SECRET=your_jwt_secret_key_here

# ==========================================
# SMTP Email Service Configuration
# ==========================================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=Auto
SMTP_USER=support@example.com
SMTP_PASS=your_email_password
FOUNDER1_EMAIL=founder@example.com
# FOUNDER2_EMAIL=
# FOUNDER3_EMAIL=

# ==========================================
# Redis In-Memory Cache Configuration
# ==========================================
# Connection via Host / Port (default: 127.0.0.1:6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# Or provide a full connection string:
# REDIS_URL=redis://default:password@127.0.0.1:6379

# Default cache TTL in seconds (86400 = 24 hours)
REDIS_TTL=86400
